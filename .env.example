# Use 5433 when running DB via docker-compose (see README). Use 5432 only if that container maps 5432.
# Local PostgreSQL on Windows (default install): port 5432
DATABASE_URL=postgresql://pdc:pdc@127.0.0.1:5432/pdc
# With docker-compose db service: use port 5433 instead
# Min 32 random chars (openssl rand -hex 32). Startup FAILS if weak when APP_ENV=production.
JWT_SECRET=
APP_ENV=development
# Browser origins allowed with credentials (comma-separated). Add LAN URL if Vite host:true, e.g. http://192.168.1.10:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
# Optional: path to Google service account JSON for mirroring uploads to project GDrive folders
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=D:\secrets\pdc-drive-sa.json
# Optional: override org templates (default backend/templates/)
# TEMPLATE_DIR=D:\path\to\templates
# SKIP_TEMPLATE_VERIFY=false
CLICKUP_ENABLED=false
